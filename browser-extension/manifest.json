{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.anthropic.com/*",
    "*://*.cursor.com/*",
    "*://*.cursor.sh/*",
    "*://*.gemini.google.com/*",
    "*://*.aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MySafeAI",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "protected_sites",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "48": "icon.png"
  },
  "default_locale": "en"
}
